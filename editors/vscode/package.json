{
  "name": "gdfmt",
  "displayName": "gdfmt",
  "version": "0.1.0",
  "private": true,
  "description": "Validated GDScript formatting powered by Rust",
  "categories": [
    "Formatters"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ntnyq/gdfmt"
  },
  "publisher": "ntnyq",
  "main": "./dist/extension.cjs",
  "browser": "./dist/web/extension.js",
  "dependencies": {
    "@gdfmt/wasm": "workspace:*",
    "vscode-languageclient": "9.0.1"
  },
  "contributes": {
    "languages": [
      {
        "id": "gdscript",
        "aliases": [
          "GDScript",
          "gdscript"
        ],
        "extensions": [
          ".gd"
        ]
      }
    ],
    "commands": [
      {
        "command": "gdfmt.restartServer",
        "title": "gdfmt: Restart Server"
      },
      {
        "command": "gdfmt.showOutput",
        "title": "gdfmt: Show Output"
      },
      {
        "command": "gdfmt.showVersion",
        "title": "gdfmt: Show Version"
      }
    ],
    "configuration": {
      "title": "gdfmt",
      "properties": {
        "gdfmt.enable": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Enable GDScript document formatting."
        },
        "gdfmt.serverPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Desktop formatter executable or Node CLI script. Web always uses bundled WASM."
        },
        "gdfmt.configPath": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Explicit configuration file; empty discovers project configuration. In Web, use a workspace-relative path with /."
        }
      }
    },
    "jsonValidation": [
      {
        "fileMatch": [
          ".gdfmtrc.json",
          ".gdfmtrc.jsonc"
        ],
        "url": "./schemas/gdfmtrc.schema.json"
      }
    ]
  },
  "activationEvents": [
    "onLanguage:gdscript"
  ],
  "extensionKind": [
    "workspace"
  ],
  "engines": {
    "vscode": "^1.96.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Uses the bundled formatter. Workspace executables and custom paths require trust.",
      "restrictedConfigurations": [
        "gdfmt.serverPath",
        "gdfmt.configPath"
      ]
    },
    "virtualWorkspaces": {
      "supported": "limited",
      "description": "Web supports URI-based workspaces with bounded JSON/JSONC configuration. Desktop formatting uses local file workspaces."
    }
  },
  "gdfmtVersion": "0.1.0-alpha.6"
}
