{
  "name": "@gdfmt/gdfmt",
  "version": "0.1.0-alpha.4",
  "description": "Validated Rust GDScript formatter for Node.js and the command line",
  "keywords": [
    "formatter",
    "gdscript",
    "godot",
    "napi"
  ],
  "homepage": "https://github.com/ntnyq/gdfmt#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ntnyq/gdfmt.git",
    "directory": "packages/gdfmt"
  },
  "bin": {
    "gdfmt": "./dist/cli.cjs"
  },
  "files": [
    "dist",
    "LICENSE",
    "LICENSE-THIRD-PARTY",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./schema.json": "./dist/schema.json",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "optionalDependencies": {
    "@gdfmt/darwin-arm64": "0.1.0-alpha.4",
    "@gdfmt/darwin-x64": "0.1.0-alpha.4",
    "@gdfmt/linux-x64-gnu": "0.1.0-alpha.4",
    "@gdfmt/linux-x64-musl": "0.1.0-alpha.4",
    "@gdfmt/win32-x64-msvc": "0.1.0-alpha.4"
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0"
  }
}
