{
  "name": "@gdfmt/root",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "bench": "tsx scripts/benchmarks/run.ts",
    "build:npm": "tsx scripts/npm/build.ts",
    "build:vscode": "tsx scripts/vscode/build.ts",
    "build:vscode:web": "tsx scripts/vscode/build-web.ts",
    "build:wasm": "tsx scripts/wasm/build.ts",
    "docs:build": "pnpm -C docs run build",
    "docs:dev": "pnpm -C docs run dev",
    "format": "oxfmt",
    "package:vscode": "tsx scripts/vscode/package.ts",
    "package:vscode:web": "tsx scripts/vscode/package-web.ts",
    "prepare": "husky",
    "release:check": "tsx scripts/release/check.ts",
    "release:prepare": "tsx scripts/release/prepare.ts",
    "release:publish:crates": "tsx scripts/release/publish-crates.ts",
    "release:publish:marketplace": "tsx scripts/release/marketplace.ts",
    "release:publish:npm": "tsx scripts/release/publish-npm.ts",
    "release:version": "tsx scripts/release/version.ts",
    "test:bench": "tsx --test tests/benchmarks/*.test.ts",
    "test:docs": "pnpm docs:build && tsx --test tests/docs/*.test.ts",
    "test:npm": "tsx scripts/npm/check-package.ts",
    "test:release": "tsx --test tests/release/*.test.ts",
    "test:trials": "tsx --test tests/project-trials/*.test.ts",
    "test:vscode": "tsx scripts/vscode/test.ts",
    "test:vscode:marketplace": "tsx scripts/vscode/test-marketplace.ts",
    "test:vscode:web": "tsx scripts/vscode/test-web.ts",
    "test:vscode:web:unit": "tsx --test tests/vscode-web/*.test.ts",
    "test:wasm": "tsx scripts/wasm/check-package.ts",
    "trials": "tsx scripts/project-trials/run.ts",
    "typecheck": "tsc --noEmit -p scripts/tsconfig.json",
    "typecheck:docs": "pnpm -C docs run typecheck",
    "typecheck:vscode": "tsc --noEmit -p editors/vscode/tsconfig.json",
    "typecheck:vscode:web": "tsc --noEmit -p editors/vscode/tsconfig.web.json",
    "verify:npm": "tsx scripts/npm/verify-artifacts.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/vscode": "1.96.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/test-web": "^0.0.81",
    "@vscode/vsce": "^4.0.0",
    "bumpp": "^12.3.0",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "nano-staged": "^1.0.2",
    "npm-run-all2": "^9.0.4",
    "oxfmt": "^0.74.0",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "nano-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "packageManager": "pnpm@12.15.0"
}
