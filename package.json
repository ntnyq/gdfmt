{
  "name": "@gdfmt/root",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:npm": "tsx scripts/npm/build.ts",
    "docs:build": "pnpm -C docs run build",
    "docs:dev": "pnpm -C docs run dev",
    "format": "oxfmt",
    "prepare": "husky",
    "test:npm": "tsx scripts/npm/check-package.ts",
    "typecheck": "tsc --noEmit -p scripts/tsconfig.json",
    "verify:npm": "tsx scripts/npm/verify-artifacts.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "bumpp": "^12.3.0",
    "husky": "^9.1.7",
    "nano-staged": "^1.0.2",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.74.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.14.0"
}
