{
  "name": "@gdfmt/root",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:npm": "tsx scripts/npm/build.ts",
    "docs:build": "pnpm -C docs run build",
    "docs:dev": "pnpm -C docs run dev",
    "format": "oxfmt",
    "prepare": "husky",
    "release:check": "tsx scripts/release/check.ts",
    "release:prepare": "tsx scripts/release/prepare.ts",
    "release:publish:crates": "tsx scripts/release/publish-crates.ts",
    "release:publish:npm": "tsx scripts/release/publish-npm.ts",
    "release:version": "tsx scripts/release/version.ts",
    "test:npm": "tsx scripts/npm/check-package.ts",
    "test:release": "tsx --test tests/release/*.test.ts",
    "test:trials": "tsx --test tests/project-trials/*.test.ts",
    "trials": "tsx scripts/project-trials/run.ts",
    "typecheck": "tsc --noEmit -p scripts/tsconfig.json",
    "verify:npm": "tsx scripts/npm/verify-artifacts.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "bumpp": "^12.3.0",
    "husky": "^9.1.7",
    "nano-staged": "^1.0.2",
    "npm-run-all2": "^9.0.4",
    "oxfmt": "^0.74.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "nano-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "packageManager": "pnpm@12.14.0"
}
